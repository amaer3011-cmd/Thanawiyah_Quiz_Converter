# توكن بوت تليجرام من BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenHere

# مفتاح أو أكثر من مفاتيح Gemini API (مفصولة بفاصلة بدون مسافات)
# احصل على مفتاح مجاني من: https://aistudio.google.com/app/apikey
# للمفتاح الواحد استخدم GEMINI_API_KEY، ولعدة مفاتيح استخدم GEMINI_API_KEYS.
GEMINI_API_KEY=AIzaSy_your_real_key_here
# GEMINI_API_KEYS=AIzaSy_key_one,AIzaSy_key_two

# مفتاح TranscriptAPI.com لجلب ترجمة YouTube عبر REST API
TRANSCRIPT_API_KEY=ta_your_real_key_here
# TRANSCRIPT_API_BASE=https://transcriptapi.com/api/v2
# TRANSCRIPT_API_TIMEOUT=45

# احتياطي اختياري عبر OpenRouter (مفاتيح ونماذج مفصولة بفواصل)
# للمفتاح الواحد استخدم OPENROUTER_API_KEY، ولعدة مفاتيح استخدم OPENROUTER_API_KEYS.
OPENROUTER_API_KEY=sk-or-v1-your_real_key_here
# OPENROUTER_API_KEYS=sk-or-v1-key_one,sk-or-v1-key_two
OPENROUTER_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini
AI_REQUEST_TIMEOUT=60
AI_RETRIES=2

# اختياري - أسماء الموديلات (لها قيم افتراضية جيدة، غيّرها فقط لو عاوز)
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# اختياري - مجلد مؤقت لتخزين الملفات أثناء المعالجة
# TEMP_DIR=/tmp/quizbot

# اختياري - الصور التوضيحية (SVG) لبعض الأسئلة
# ENABLE_QUESTION_IMAGES=true
# MAX_IMAGES_PER_QUIZ=6

# اختياري - تقسيم توليد الأسئلة لدفعات (batching) للكويزات الكبيرة
# BATCH_THRESHOLD=12
# QUESTIONS_PER_BATCH=10

# اختياري - المدة الافتراضية للامتحان المؤقت بالدقائق (لو المستخدم مكتبش رقم)
# DEFAULT_DURATION_MINUTES=10
